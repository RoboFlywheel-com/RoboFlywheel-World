# Copy to .env.local and supply local paths. Never add credentials to this file.
PVSCENE_SIMREADY_LIBRARY_VERSION=v1.3
PVSCENE_SIMREADY_INDEX=/path/to/simready_lib_v1.3/index.json
PVSCENE_SIMREADY_ASSETS_ROOT=/path/to/release/v1.3/assets
PVSCENE_SIMREADY_SEMANTIC_INDEX=/path/to/simready_lib/classes.json.gz
PVSCENE_PREPARED_DIR=/path/to/prepared/sbert/all-mpnet-base-v2
PVSCENE_HSSD_ROOT=/path/to/hssd-models
PVSCENE_HSSD_SYNSET_INDEX=/path/to/preprocessed/hssd_wnsynsetkey_index.json
PVSCENE_RUNTIME_PYTHON=/path/to/runtime/bin/python
PVSCENE_STDLIB_PYTHON=/path/to/stdlib/bin/python
RFW_INFINIGEN_ROOT=/path/to/standalone/infinigen
RFW_SCENE_PYTHON=/path/to/runtime/bin/python
PVSCENE_ISAAC_PYTHON=/path/to/isaac-env/bin/python
# Only set OMNI_KIT_ACCEPT_EULA=YES after you have accepted the NVIDIA license.
